 "blocks": [
  {
   "id": "zoku-gunsho-norinaga-taku-0001",
   "pid": "nao-729561",
   "pages": [
    1
   ],
   "text": "一難にしてここからさむしのふれとかはかりみよりあまる我恋覚暹右あさましやあさまのたけの見ねことにつらきも知らす日遊る我恋みねことにあさまのたけのけふりあひて見にあまるこひのほと母しられす施水宅飲合年月同範永宅歌合年月日十番是野花小鷹狩駒迎十五夜月秋田露属霧鹿擣衣歌人一番野花左勝宮若乳母秋のもしたはのみとりなかりけりにゑきとみゆる花のにほひに右小禅師聖梵一云々",
   "poems": [
    "1",
    "2",
    "3"
   ]
  },
  {
   "id": "zoku-gunsho-norinaga-taku-0002",
   "pid": "nao-729561",
   "pages": [
    2
   ],
   "text": "秋野にしめやゆはましさま〳〵にいろめく花のうしろめたさに二番小鷹狩左宮若乳母むらとりいかゝきくらんたかはなしかりはのをのゝすゝ虫のこゑ勝お成元古勝かりくれぬ野辺にこよひはたひねしてけさの枕にすゝ虫のなく三番駒迎左勝宮若乳母則元右あふさかのけきのあなたにひきつれていまやこゆらんきり原のこま四番十五夜左小乳母あまのはらみちそすめる秋の月てらさぬさとはあらしとそおもふ右勝右成元つねよりも秋の春かはの月影にまさるひかりはあらしとそおもふ五番秋田庄式部こなかるそらをやたのむ秋のたはくるほともなき右勝小禅師",
   "poems": [
    "4",
    "5",
    "6",
    "7",
    "8",
    "9",
    "10"
   ]
  },
  {
   "id": "zoku-gunsho-norinaga-taku-0003",
   "pid": "nao-729561",
   "pages": [
    3
   ],
   "text": "うへしよりかりてほすまてをやまたのくさはのいほにいくよねぬらん六番露左若宮乳母くさしけきあさちかはらにおくつゆをいとにもぬかぬ玉とみるかな勝則元右勝しらつめのおくあれたには秋風をいともわかみとなりにけるかな七番雁乳母左勝ころもうすみねられぬ秋のさよなかには風すゝしくかりそなる五郎君右ゆきかへりここなるかりかねはかよふ雲ちをいかゝわくらん八番霧左小乳母はゝそやまおほつかなしや秋きりのもみちのにしきたちしみ右成元秋きりのやまへもみえすたちぬれはもみちのにしきにやなからん九番鹿左勝若乳母しかのねにあまをしるかなたにさこのをのへの松はみとりなれとも右",
   "poems": [
    "11",
    "12",
    "13",
    "14",
    "15",
    "16",
    "17",
    "18"
   ]
  },
  {
   "id": "zoku-gunsho-norinaga-taku-0004",
   "pid": "nao-729561",
   "pages": [
    4
   ],
   "text": "まつこふるこゑなかりけはさをしかのたへまを人はいかてしらまし十番楼衣左式部よとゝもにころもうつなるおとにまて人まつやとはしるへきこゆれ右秋風のふきしまされはかりころもうつ春あまたきこゆなるかな歌絵合やみひの十日あまりのゆふくれに月影みつにうつるおりしも人あまたさふらひて物かたりのついてにたれともなくいひあはせしはるの日のつれ〳〵にくらすよりはつねならぬいとみことをおまへに御覧せさせはやむかしよりきこゆる花あはせなとはちりてふるきねにかへりぬれはにほひこひしくくさあはせとかはたつねてもとのところにかへしやれはなこりうるさしさておくらか歌林とかいふなるより古万",
   "poems": [
    "19",
    "20",
    "21",
    "22",
    "23"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "一難にしてここからさむしのふれとかはかりみよりあまる我恋",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": ""
  },
  {
   "seq": "2",
   "text": "あさましやあさまのたけの見ねことにつらきも知らす日遊る我恋",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "秋のもしたはのみとりなかりけりにゑきとみゆる花のにほひに",
   "kana": "",
   "speaker": "宮若乳母",
   "page": 1,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "4",
   "text": "秋野にしめやゆはましさま〳〵にいろめく花のうしろめたさに",
   "kana": "",
   "speaker": "小禅師聖梵一云々",
   "page": 2,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "5",
   "text": "むらとりいかゝきくらんたかはなしかりはのをのゝすゝ虫のこゑ",
   "kana": "",
   "speaker": "宮若乳母",
   "page": 2,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "6",
   "text": "かりくれぬ野辺にこよひはたひねしてけさの枕にすゝ虫のなく",
   "kana": "",
   "speaker": "成元",
   "page": 2,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "",
   "dai": ""
  },
  {
   "seq": "7",
   "text": "あふさかのけきのあなたにひきつれていまやこゆらんきり原のこま",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "8",
   "text": "あまのはらみちそすめる秋の月てらさぬさとはあらしとそおもふ",
   "kana": "",
   "speaker": "小乳母",
   "page": 2,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "9",
   "text": "つねよりも秋の春かはの月影にまさるひかりはあらしとそおもふ",
   "kana": "",
   "speaker": "成元",
   "page": 2,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "10",
   "text": "こなかるそらをやたのむ秋のたはくるほともなき",
   "kana": "",
   "speaker": "式部",
   "page": 2,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "うへしよりかりてほすまてをやまたのくさはのいほにいくよねぬらん",
   "kana": "",
   "speaker": "小禅師",
   "page": 3,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "12",
   "text": "くさしけきあさちかはらにおくつゆをいとにもぬかぬ玉とみるかな",
   "kana": "",
   "speaker": "若宮乳母",
   "page": 3,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "しらつめのおくあれたには秋風をいともわかみとなりにけるかな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "14",
   "text": "ころもうすみねられぬ秋のさよなかには風すゝしくかりそなる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "15",
   "text": "ゆきかへりここなるかりかねはかよふ雲ちをいかゝわくらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "16",
   "text": "はゝそやまおほつかなしや秋きりのもみちのにしきたちしみ",
   "kana": "",
   "speaker": "小乳母",
   "page": 3,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "17",
   "text": "秋きりのやまへもみえすたちぬれはもみちのにしきにやなからん",
   "kana": "",
   "speaker": "成元",
   "page": 3,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "18",
   "text": "しかのねにあまをしるかなたにさこのをのへの松はみとりなれとも",
   "kana": "",
   "speaker": "若乳母",
   "page": 3,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "19",
   "text": "まつこふるこゑなかりけはさをしかのたへまを人はいかてしらまし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "20",
   "text": "よとゝもにころもうつなるおとにまて人まつやとはしるへきこゆれ",
   "kana": "",
   "speaker": "式部",
   "page": 4,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "21",
   "text": "秋風のふきしまされはかりころもうつ春あまたきこゆなるかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "22",
   "text": "日のつれ〳〵にくらすよりはつねならぬいとみ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "23",
   "text": "ことをおまへに御覧せさせはやむかしよりきこ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729561",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  }
 ],
